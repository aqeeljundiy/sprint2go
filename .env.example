# Local server settings. Copy to .env to change them (.env is never committed).

# Password every demo person gets on the first run (change it in the app afterwards).
SEED_PASSWORD=sprint2go-local-demo

# Optional: a Claude key the server uses for "included" AI. Companies can also add their own keys in Settings, AI.
# ANTHROPIC_API_KEY=

# PORT=8787

# Optional: the meeting recorder (recorder/, its own service). Without it, "Send notetaker" runs a demo.
# RECORDER_URL=http://localhost:4360
# RECORDER_SECRET=a-long-random-string (the same value in the recorder's environment)
# Where the recorder can reach this server for its reports (defaults to http://localhost:$PORT).
# PUBLIC_URL=https://app.sprint2go.com

# Optional: agencies' own addresses (portal.theiragency.com) get a Let's Encrypt certificate through Dokploy.
# All three are needed; without them the app says "Ready once sprint2go turns on custom addresses". See docs/custom-domains.md.
# DOKPLOY_URL=http://178.212.35.85:3000
# DOKPLOY_API_KEY=(Dokploy, Settings, Profile, API/CLI, Generate)
# DOKPLOY_APP_ID=(the sprint2go application's id, the last part of its address in Dokploy)
# What agencies point their address at (default custom.sprint2go.com), and this server's public IPv4 for addresses
# that need an A record (default: what custom.sprint2go.com resolves to).
# CUSTOM_DOMAIN_TARGET=custom.sprint2go.com
# CUSTOM_DOMAIN_IP=178.212.35.85
# Other addresses that open the app itself (comma-separated). With PUBLIC_URL set, any other address that isn't a live
# agency address gets a plain "This address isn't set up" page.
# APP_HOSTS=
