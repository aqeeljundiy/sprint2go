# Local server settings. Copy to .env to change them (.env is never committed).

# Password every demo person gets on the first run (change it in the app afterwards).
SEED_PASSWORD=sprint2go-local-demo

# Optional: a Claude key the server uses for "included" AI. Companies can also add their own keys in Settings, AI.
# ANTHROPIC_API_KEY=

# PORT=8787

# Optional: the meeting recorder (recorder/, its own service). Without it, "Send notetaker" runs a demo.
# RECORDER_URL=http://localhost:4360
# RECORDER_SECRET=a-long-random-string (the same value in the recorder's environment)
# Where the recorder can reach this server for its reports (defaults to http://localhost:$PORT).
# PUBLIC_URL=https://app.sprint2go.com

# Optional: a trusted certificate for the mail server (STARTTLS). CF_DNS_TOKEN is a Cloudflare API token with Zone DNS
# Edit for MAIL_HOST's zone: Let's Encrypt then issues and renews one by itself (CF_ZONE_ID skips the zone lookup,
# ACME_STAGING=1 uses Let's Encrypt's test service). Or point MAIL_TLS_CERT / MAIL_TLS_KEY at certificate files.
# CF_DNS_TOKEN=
# MAIL_TLS_CERT=
# MAIL_TLS_KEY=
