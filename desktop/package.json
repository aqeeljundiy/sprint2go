{
  "name": "sprint2go-desktop",
  "productName": "sprint2go",
  "version": "0.1.0",
  "description": "sprint2go for Mac and Windows",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sprint2go.desktop",
    "productName": "sprint2go",
    "directories": { "output": "release" },
    "publish": { "provider": "github", "owner": "aqeeljundiy", "repo": "sprint2go", "releaseType": "release" },
    "files": ["main.cjs", "preload.cjs", "icon.png"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }, { "target": "zip", "arch": ["universal"] }],
      "artifactName": "${productName}-${version}-mac.${ext}",
      "icon": "icon.png",
      "identity": null
    },
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "${productName}-Setup-${version}.${ext}" },
    "portable": { "artifactName": "${productName}-Portable-${version}.${ext}" }
  }
}
